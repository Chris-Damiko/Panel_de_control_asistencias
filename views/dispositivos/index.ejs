<%- include('../partials/header') %>

<div class="view-header-row">
  <div>
    <span class="eyebrow">Terminal de acceso</span>
    <h1>Lector biométrico</h1>
    <p>
      Estado y datos del terminal que registra entradas y salidas.
      <% if (mode === 'simulated') { %>Funcionando en modo simulado: el flujo es idéntico al real y se cambia con una variable de entorno cuando llegue el equipo.<% } %>
    </p>
  </div>
</div>

<% if (error) { %>
  <p class="alert alert-error">No se pudo consultar el dispositivo: <%= error %></p>
<% } %>

<% if (!device) { %>
  <div class="panel empty-state">
    <h2>Sin dispositivo conectado</h2>
    <p>Revisá <code>HIKVISION_MODE</code> y la configuración del terminal en <code>.env</code>.</p>
  </div>
<% } else { %>
<div class="bento">

  <section class="panel dev-hero">
    <div class="dev-art" aria-hidden="true">
      <svg viewBox="0 0 120 160" fill="none">
        <rect x="18" y="6" width="84" height="148" rx="16" fill="currentColor" opacity=".12"/>
        <rect x="18" y="6" width="84" height="148" rx="16" stroke="currentColor" stroke-width="2"/>
        <rect x="30" y="20" width="60" height="54" rx="8" fill="currentColor" opacity=".18"/>
        <circle cx="60" cy="47" r="14" stroke="currentColor" stroke-width="2"/>
        <path d="M54 47l4 4 8-9" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"/>
        <rect x="30" y="88" width="60" height="42" rx="8" stroke="currentColor" stroke-width="2"/>
        <path d="M60 96c-8 0-13 6-13 14M60 101c-5 0-8 4-8 9M60 106c-2 0-3 2-3 4M60 96c8 0 13 6 13 14" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
        <circle cx="60" cy="142" r="3" fill="currentColor"/>
      </svg>
      <span class="scan-line"></span>
    </div>
    <div class="dev-main">
      <div class="dev-title">
        <div>
          <span class="eyebrow"><%= device.type === 'accessControl' ? 'Control de acceso' : device.type %></span>
          <h2 class="dev-model"><%= device.model %></h2>
          <p class="dev-name"><%= device.name %> · <span class="mono"><%= device.id %></span></p>
        </div>
        <span class="pill pill-ok"><span class="pill-dot"></span>En línea</span>
      </div>
      <dl class="spec-grid">
        <div><dt>Dirección IP</dt><dd class="mono"><%= device.ip %></dd></div>
        <div><dt>Firmware</dt><dd class="mono"><%= device.firmware %></dd></div>
        <div><dt>Compilación</dt><dd class="mono"><%= device.firmwareDate %></dd></div>
        <div><dt>Número de serie</dt><dd class="mono"><%= device.serial %></dd></div>
        <div><dt>Dirección MAC</dt><dd class="mono"><%= device.mac %></dd></div>
        <div><dt>Latencia</dt><dd class="mono"><%= device.latency %> ms</dd></div>
      </dl>
    </div>
  </section>

  <div class="tile tile-a">
    <span class="tile-icon"><svg aria-hidden="true" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.6"><circle cx="10" cy="6.5" r="3.2"/><path d="M3.5 17c.8-3.4 3.4-5.2 6.5-5.2s5.7 1.8 6.5 5.2" stroke-linecap="round"/></svg></span>
    <span class="tile-value"><%= stats.synced %><small>/<%= stats.employees %></small></span>
    <span class="tile-label">Docentes cargados en el terminal</span>
  </div>
  <div class="tile tile-b">
    <span class="tile-icon"><svg aria-hidden="true" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M4.5 10.5l3.5 3.5 7.5-8" stroke-linecap="round" stroke-linejoin="round"/></svg></span>
    <span class="tile-value"><%= stats.totalEvents %></span>
    <span class="tile-label">Eventos recibidos</span>
  </div>
  <div class="tile tile-c">
    <span class="tile-icon"><svg aria-hidden="true" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.6"><circle cx="10" cy="10" r="7"/><path d="M10 6v4l2.6 2" stroke-linecap="round" stroke-linejoin="round"/></svg></span>
    <span class="tile-value"><%= lastSync || '—' %></span>
    <span class="tile-label">Última sincronización</span>
  </div>
  <div class="tile tile-d">
    <span class="tile-icon"><svg aria-hidden="true" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M3 15l4-5 3 3 4-6 3 4" stroke-linecap="round" stroke-linejoin="round"/></svg></span>
    <span class="tile-value"><%= device.latency %><small> ms</small></span>
    <span class="tile-label">Tiempo de respuesta</span>
  </div>

  <section class="panel dev-feed">
    <div class="panel-head"><h2>Últimos eventos del terminal</h2><a class="link-quiet" href="/asistencia">Ver asistencia</a></div>
    <ol class="timeline">
      <% events.forEach((ev) => { %>
        <li class="tl-item tl-<%= ev.kind %>">
          <span class="tl-dot"></span>
          <div><b><%= ev.who %></b> · <%= ev.kind === 'entrada' ? 'entrada' : 'salida' %></div>
          <span class="tl-time mono"><%= ev.day %> · <%= ev.time %></span>
        </li>
      <% }) %>
    </ol>
  </section>
</div>
<% } %>

<%- include('../partials/footer') %>
