<%- include('partials/header') %>

<div class="view-header-row">
  <div>
    <span class="eyebrow">Identidad visual</span>
    <h1>Cómo se ve el panel</h1>
    <p>Cambiá nombre, colores, logo y favicon. La vista previa se actualiza mientras elegís.</p>
  </div>
</div>
<% if (success) { %>
  <p class="alert alert-success">Cambios guardados (<%= success %>).</p>
<% } %>

<section class="cms-section">
  <h2>Colores y nombre</h2>
  <div class="cms-cols">
  <form method="POST" action="/cms/colors" class="cms-form">
    <label for="institution_name">Nombre de la institución</label>
    <input id="institution_name" type="text" name="institution_name" value="<%= settings.institution_name %>" required>

    <label for="primary_color">Color primario (sidebar)</label>
    <div class="color-row">
      <input id="primary_color" type="color" name="primary_color" value="<%= settings.primary_color %>">
      <code><%= settings.primary_color %></code>
    </div>

    <label for="secondary_color">Color secundario (hover de menú)</label>
    <div class="color-row">
      <input id="secondary_color" type="color" name="secondary_color" value="<%= settings.secondary_color %>">
      <code><%= settings.secondary_color %></code>
    </div>

    <label for="accent_color">Color de acento (botones, enlaces activos)</label>
    <div class="color-row">
      <input id="accent_color" type="color" name="accent_color" value="<%= settings.accent_color %>">
      <code><%= settings.accent_color %></code>
    </div>

    <button type="submit">
      Guardar colores
      <span class="btn-icon-circle">
        <svg aria-hidden="true" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="2"><path d="M4.5 10.5l3.5 3.5 7.5-8" stroke-linecap="round" stroke-linejoin="round"/></svg>
      </span>
    </button>
  </form>

  <div class="mini-wrap" aria-hidden="true">
    <div class="mini-app" id="mini-app" style="--mp: <%= settings.primary_color %>; --ms: <%= settings.secondary_color %>; --ma: <%= settings.accent_color %>;">
      <div class="mini-side">
        <b><% if (settings.logo_path) { %><img src="<%= settings.logo_path %>" alt=""><% } %></b>
        <span></span><span class="on"></span><span></span><span></span>
      </div>
      <div class="mini-main">
        <div class="mini-top"><i></i><em></em></div>
        <div class="mini-hero"><u></u><u></u><i class="mini-ring"></i></div>
        <div class="mini-cards"><i></i><i></i><i></i></div>
        <div class="mini-rows"><span></span><span></span><span></span></div>
        <div class="mini-btn"></div>
      </div>
    </div>
    <p class="mini-note">Vista previa en vivo</p>
  </div>
  </div>
</section>

<section class="cms-section">
  <h2>Logo</h2>
  <% if (settings.logo_path) { %>
    <img src="<%= settings.logo_path %>" alt="Logo actual de <%= settings.institution_name %>" class="current-logo">
  <% } %>
  <form method="POST" action="/cms/logo" enctype="multipart/form-data" class="cms-form">
    <input type="file" name="logo" accept="image/png,image/jpeg,image/svg+xml" required>
    <button type="submit">
      Subir logo
      <span class="btn-icon-circle">
        <svg aria-hidden="true" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="2"><path d="M10 13V4M6.5 7.5L10 4l3.5 3.5M4 16.5h12" stroke-linecap="round" stroke-linejoin="round"/></svg>
      </span>
    </button>
  </form>
</section>

<section class="cms-section">
  <h2>Favicon</h2>
  <% if (settings.favicon_path) { %>
    <img src="<%= settings.favicon_path %>" alt="Favicon actual" class="current-favicon">
  <% } %>
  <form method="POST" action="/cms/favicon" enctype="multipart/form-data" class="cms-form">
    <input type="file" name="favicon" accept="image/png,image/x-icon" required>
    <button type="submit">
      Subir favicon
      <span class="btn-icon-circle">
        <svg aria-hidden="true" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="2"><path d="M10 13V4M6.5 7.5L10 4l3.5 3.5M4 16.5h12" stroke-linecap="round" stroke-linejoin="round"/></svg>
      </span>
    </button>
  </form>
</section>

<script>
  (function () {
    var app = document.getElementById('mini-app');
    if (!app) return;
    [['primary_color', '--mp'], ['secondary_color', '--ms'], ['accent_color', '--ma']].forEach(function (pair) {
      var input = document.getElementById(pair[0]);
      if (!input) return;
      input.addEventListener('input', function () {
        app.style.setProperty(pair[1], input.value);
        var code = input.parentElement.querySelector('code');
        if (code) code.textContent = input.value.toUpperCase();
      });
    });
  })();
</script>

<%- include('partials/footer') %>
