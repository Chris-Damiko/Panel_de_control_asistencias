<%- include('../partials/header') %>

<div class="view-header-row">
  <div>
    <span class="eyebrow">Personal docente</span>
    <h1>Docentes de la jornada nocturna</h1>
    <p>Cada docente se sincroniza con el terminal al importarlo. Acá ves su estado de hoy y del terminal.</p>
  </div>
</div>

<% if (result && result.error) { %>
  <p class="alert alert-error"><%= result.error %></p>
<% } else if (result && result.imported) { %>
  <p class="alert alert-success">
    Importados: <%= result.imported %> · Sincronizados: <%= result.synced %>
    · Con foto: <%= result.faceSynced %> · Errores: <%= result.errors %>
  </p>
<% } %>

<div class="split">

  <section class="people" aria-label="Docentes">
    <div class="people-summary">
      <span class="chip"><b class="mono"><%= stats.employees %></b> docentes</span>
      <span class="chip chip-live"><span class="live-dot"></span><b class="mono"><%= stats.synced %></b> sincronizados</span>
      <% if (stats.pending) { %><span class="chip"><b class="mono"><%= stats.pending %></b> pendientes</span><% } %>
      <% if (stats.errors) { %><span class="chip"><b class="mono"><%= stats.errors %></b> con error</span><% } %>
    </div>

    <% if (people.length === 0) { %>
      <div class="panel empty-state">
        <span class="tile-icon"><svg aria-hidden="true" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.6"><circle cx="10" cy="6.5" r="3.2"/><path d="M3.5 17c.8-3.4 3.4-5.2 6.5-5.2s5.7 1.8 6.5 5.2" stroke-linecap="round"/></svg></span>
        <h2>Todavía no hay docentes</h2>
        <p>Importá una nómina en el panel de la derecha y cada fila se sincroniza sola con el terminal.</p>
      </div>
    <% } %>

    <ul class="people-grid">
      <% people.forEach((p) => { %>
        <li class="person panel">
          <div class="person-top">
            <span class="avatar avatar-lg av-<%= p.tone %>" aria-hidden="true"><%= p.initials %></span>
            <div class="person-id">
              <b><%= p.short %></b>
              <span class="mono"><%= p.cedula || p.employee_no %></span>
            </div>
            <%- include('../partials/status-pill', { status: p.sync_status }) %>
          </div>
          <dl class="person-meta">
            <div><dt>Asignatura</dt><dd><%= p.department || '—' %></dd></div>
            <div><dt>Cargo</dt><dd><%= p.position || '—' %></dd></div>
          </dl>
          <div class="person-foot">
            <% if (p.today === 'inside') { %>
              <span class="pill pill-ok"><span class="pill-dot"></span>En aula · <%= p.entrada %></span>
            <% } else if (p.today === 'done') { %>
              <span class="pill pill-neutral"><span class="pill-dot"></span>Completó la jornada</span>
            <% } else { %>
              <span class="pill pill-warn"><span class="pill-dot"></span>Sin entrada hoy</span>
            <% } %>
            <span class="person-face<%= p.photo_path ? ' has-face' : '' %>"><%= p.photo_path ? 'Rostro registrado' : 'Sin rostro' %></span>
          </div>
        </li>
      <% }) %>
    </ul>
  </section>

  <aside class="panel import-panel" aria-label="Importar nómina">
    <div class="panel-head"><h2>Importar nómina</h2><span class="chip">modo <%= hikvisionMode %></span></div>
    <p>Excel o CSV con <code>Número Empleado</code> (o <code>Cédula</code>), <code>Nombre</code>, <code>Departamento</code>, <code>Cargo</code>, <code>Género</code> y <code>N° Tarjeta</code>. Cada fila se envía al terminal al importar.</p>
    <form method="POST" action="/personas/importar" enctype="multipart/form-data" class="cms-form import-form">
      <label class="dropzone" for="nomina">
        <span class="dz-icon"><svg aria-hidden="true" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M10 13V4M6.5 7.5L10 4l3.5 3.5M4 16.5h12" stroke-linecap="round" stroke-linejoin="round"/></svg></span>
        <b data-name-for="nomina">Elegir archivo de nómina</b>
        <small>.xlsx, .xls o .csv</small>
        <input id="nomina" type="file" name="nomina" accept=".xlsx,.xls,.csv" required>
      </label>
      <label class="dropzone dz-soft" for="fotos">
        <span class="dz-icon"><svg aria-hidden="true" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.6"><rect x="3" y="4.5" width="14" height="11" rx="2.2"/><circle cx="8" cy="9" r="1.4"/><path d="M4 14.5l4-3.5 3 2.5 2.5-2 3 3" stroke-linecap="round" stroke-linejoin="round"/></svg></span>
        <b data-name-for="fotos">Fotos de rostro (opcional)</b>
        <small>Nombrá cada archivo con el número de empleado, ej. 1023.jpg</small>
        <input id="fotos" type="file" name="fotos" accept="image/jpeg,image/png" multiple>
      </label>
      <button type="submit">
        Importar y sincronizar
        <span class="btn-icon-circle">
          <svg aria-hidden="true" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="2"><path d="M10 3v10M6 9l4 4 4-4M4 16.5h12" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </span>
      </button>
    </form>
  </aside>

</div>

<script>
  document.querySelectorAll('.dropzone input[type=file]').forEach(function (input) {
    input.addEventListener('change', function () {
      var label = document.querySelector('[data-name-for="' + input.id + '"]');
      if (!label) return;
      var n = input.files.length;
      label.textContent = n === 0 ? label.dataset.default : (n === 1 ? input.files[0].name : n + ' archivos elegidos');
      input.closest('.dropzone').classList.toggle('has-file', n > 0);
    });
    var lbl = document.querySelector('[data-name-for="' + input.id + '"]');
    if (lbl) lbl.dataset.default = lbl.textContent;
  });
</script>

<%- include('../partials/footer') %>
