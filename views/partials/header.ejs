<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="description" content="Panel de control de acceso de <%= settings.institution_name %>: dispositivos, personas y asistencia.">
  <title><%= settings.institution_name %> — Control de Acceso</title>
  <% if (settings.favicon_path) { %>
    <link rel="icon" href="<%= settings.favicon_path %>">
  <% } else { %>
    <link rel="icon" href="data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 24 24%22><rect width=%2224%22 height=%2224%22 rx=%226%22 fill=%22%232563eb%22/><path d=%22M8 12.5l2.8 2.8L16.5 9%22 stroke=%22white%22 stroke-width=%222.2%22 fill=%22none%22 stroke-linecap=%22round%22 stroke-linejoin=%22round%22/></svg>">
  <% } %>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@500;600;700&family=Work+Sans:wght@400;500;600&family=JetBrains+Mono:wght@500&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/css/app.css">
  <style>
    /* Va DESPUÉS de app.css a propósito: misma especificidad en :root,
       gana el que carga último - así el branding real pisa los valores
       por defecto del archivo en vez de al revés. */
    :root {
      --primary: <%= settings.primary_color %>;
      --secondary: <%= settings.secondary_color %>;
      --accent: <%= settings.accent_color %>;
    }
  </style>
</head>
<body>
  <div class="ambient-glow" aria-hidden="true"></div>
  <a href="#main-content" class="skip-link">Saltar al contenido</a>
  <div class="app-shell">
    <aside class="sidebar">
      <div class="brand">
        <% if (settings.logo_path) { %>
          <img src="<%= settings.logo_path %>" alt="Logo de <%= settings.institution_name %>" class="brand-logo">
        <% } %>
        <span class="brand-name"><%= settings.institution_name %></span>
      </div>
      <nav aria-label="Navegación principal">
        <a href="/dashboard" aria-label="Resumen" class="<%= currentPath === '/dashboard' ? 'active' : '' %>" <%= currentPath === '/dashboard' ? 'aria-current="page"' : '' %>>
          <svg class="nav-icon" aria-hidden="true" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.6"><rect x="2.5" y="2.5" width="6.5" height="6.5" rx="1.4"/><rect x="11" y="2.5" width="6.5" height="6.5" rx="1.4"/><rect x="2.5" y="11" width="6.5" height="6.5" rx="1.4"/><rect x="11" y="11" width="6.5" height="6.5" rx="1.4"/></svg>
          <span class="nav-label">Resumen</span>
        </a>
        <a href="/dispositivos" aria-label="Terminal" class="<%= currentPath === '/dispositivos' ? 'active' : '' %>" <%= currentPath === '/dispositivos' ? 'aria-current="page"' : '' %>>
          <svg class="nav-icon" aria-hidden="true" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.6"><rect x="4" y="2.5" width="12" height="15" rx="2.2"/><circle cx="10" cy="10" r="2.6"/><path d="M10 5.4v.1M7.2 14.6h5.6" stroke-linecap="round"/></svg>
          <span class="nav-label">Terminal</span>
        </a>
        <a href="/personas" aria-label="Personal" class="<%= currentPath === '/personas' ? 'active' : '' %>" <%= currentPath === '/personas' ? 'aria-current="page"' : '' %>>
          <svg class="nav-icon" aria-hidden="true" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.6"><circle cx="10" cy="6.5" r="3.2"/><path d="M3.5 17c.8-3.4 3.4-5.2 6.5-5.2s5.7 1.8 6.5 5.2" stroke-linecap="round"/></svg>
          <span class="nav-label">Personal</span>
        </a>
        <a href="/asistencia" aria-label="Asistencia" class="<%= currentPath === '/asistencia' ? 'active' : '' %>" <%= currentPath === '/asistencia' ? 'aria-current="page"' : '' %>>
          <svg class="nav-icon" aria-hidden="true" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.6"><circle cx="10" cy="10" r="7"/><path d="M10 6v4l2.6 2" stroke-linecap="round" stroke-linejoin="round"/></svg>
          <span class="nav-label">Asistencia</span>
        </a>
        <% if (typeof session !== 'undefined' && session.role === 'admin') { %>
          <a href="/cms" aria-label="Identidad visual" class="<%= currentPath === '/cms' ? 'active' : '' %>" <%= currentPath === '/cms' ? 'aria-current="page"' : '' %>>
            <svg class="nav-icon" aria-hidden="true" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M10 2.5a7 7 0 100 14c1 0 1.7-.6 1.7-1.5 0-.5-.2-.8-.4-1.1-.2-.3-.4-.6-.4-1 0-.7.6-1.2 1.3-1.2h1.4a3 3 0 003-3c0-3.4-3.2-6.2-6.6-6.2z"/><circle cx="6.6" cy="9" r=".9" fill="currentColor" stroke="none"/><circle cx="9.4" cy="6" r=".9" fill="currentColor" stroke="none"/><circle cx="12.6" cy="7.4" r=".9" fill="currentColor" stroke="none"/></svg>
            <span class="nav-label">Identidad visual</span>
          </a>
        <% } %>
      </nav>
      <form action="/logout" method="POST" class="logout-form">
        <button type="submit">
          Cerrar sesión
          <span class="btn-icon-circle">
            <svg aria-hidden="true" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M8 3H4.5a1 1 0 00-1 1v12a1 1 0 001 1H8M13 13.5L17 10l-4-3.5M17 10H7" stroke-linecap="round" stroke-linejoin="round"/></svg>
          </span>
        </button>
      </form>
    </aside>
    <main class="content" id="main-content">
      <%
        const pageTitles = { '/dashboard': 'Resumen', '/dispositivos': 'Terminal', '/personas': 'Personal', '/asistencia': 'Asistencia', '/cms': 'Identidad visual' };
        const userName = (typeof session !== 'undefined' && session.fullName) ? session.fullName : 'Usuario';
        const userRole = (typeof session !== 'undefined' && session.role === 'admin') ? 'Administrador' : 'Operador';
        const userInitials = userName.split(/\s+/).slice(0, 2).map((w) => w[0]).join('').toUpperCase();
      %>
      <header class="topbar">
        <nav class="crumbs" aria-label="Ruta">
          <span class="crumb-root"><%= settings.institution_name %></span>
          <svg aria-hidden="true" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M7.5 4.5L13 10l-5.5 5.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
          <strong><%= pageTitles[currentPath] || '' %></strong>
        </nav>
        <div class="topbar-right">
          <span class="chip chip-live"><span class="live-dot"></span>Terminal en línea</span>
          <span class="chip chip-clock" id="live-clock" aria-label="Hora de Ecuador">--:--:--</span>
          <span class="user-chip">
            <span class="avatar av-0" aria-hidden="true"><%= userInitials %></span>
            <span class="user-meta"><b><%= userName %></b><i><%= userRole %></i></span>
          </span>
        </div>
      </header>
      <div class="content-inner">
