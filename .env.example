# Servidor
PORT=3000
SESSION_SECRET=cambia_este_valor

# Datos: se guardan como archivos JSON en data/ (ya no se usa MySQL)

# Adaptador Hikvision: "isapi" o "openapi"
HIKVISION_MODE=isapi

# ISAPI (dispositivo directo)
ISAPI_HOST=192.168.1.10
ISAPI_PORT=80
ISAPI_USER=admin
ISAPI_PASSWORD=

# OpenAPI / Artemis (HikCentral)
ARTEMIS_HOST=127.0.0.1
ARTEMIS_PORT=443
ARTEMIS_APP_KEY=
ARTEMIS_APP_SECRET=

# Admin inicial: se crea al arrancar si data/users.json está vacío
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=Administrador

# Respaldo de data/*.json y public/uploads/ en un repo de GitHub (opcional, para hosts con disco efímero)
# Puede ser el mismo repo del código. Token fine-grained con Contents: Read and write.
# Ojo: si el repo es público, los datos también lo son.
GITHUB_TOKEN=
GITHUB_DATA_REPO=usuario/repo-datos
GITHUB_DATA_BRANCH=
GITHUB_SYNC_DEBOUNCE_MS=30000
